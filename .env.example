# ---------------------------------------------------------------------------
# iHost Sensor Log -- environment variables
# On the iHost these go in the add-on's "Run" settings panel, one per row.
# ---------------------------------------------------------------------------

# --- gateway ---------------------------------------------------------------
# Use the iHost's IP if ihost.local is unreliable on your network.
# Give the iHost a static DHCP lease either way.
CUBE_BASE_URL=http://ihost.local
# Leave empty and pair from the Web UI instead (recommended).
CUBE_ACCESS_TOKEN=

SITE_NAME=Home
TZ=Asia/Bahrain
LOG_LEVEL=INFO

# --- storage ---------------------------------------------------------------
DATA_DIR=/data
RETENTION_DAYS=400
HEARTBEAT_SEC=900
# Ignore numeric wobble smaller than this (per-capability overrides live in
# rules.json -> "deadbands").
DEADBAND_DEFAULT=0
# SD card protection: buffer writes, commit in batches.
WRITE_FLUSH_SEC=5
WRITE_FLUSH_ROWS=200

# --- collector -------------------------------------------------------------
# Full REST sweep interval. The safety net behind the live stream.
POLL_INTERVAL_SEC=600

# --- external backup -------------------------------------------------------
# none | influx2 | influx1 | http | mqtt
SINK_TYPE=none

# influx2
# SINK_TYPE=influx2
# SINK_URL=https://eu-central-1-1.aws.cloud2.influxdata.com
# SINK_TOKEN=your-influx-token
# SINK_ORG=your-org
# SINK_BUCKET=ihost

# influx1
# SINK_TYPE=influx1
# SINK_URL=http://192.168.1.50:8086
# SINK_DB=ihost
# SINK_USER=
# SINK_PASS=

# generic HTTPS endpoint (POSTs a JSON batch)
# SINK_TYPE=http
# SINK_URL=https://your-server.example/ingest
# SINK_TOKEN=bearer-token-if-any

# mqtt
# SINK_TYPE=mqtt
# MQTT_HOST=192.168.1.50
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASS=
# MQTT_TOPIC_PREFIX=ihost

FORWARD_INTERVAL_SEC=60
FORWARD_BATCH=500

# --- alerts: telegram (recommended primary channel) ------------------------
# 1. Message @BotFather, /newbot, copy the token.
# 2. Message your new bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- alerts: email ---------------------------------------------------------
# Gmail/Outlook need an APP PASSWORD, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=you@gmail.com
SMTP_TO=you@gmail.com,someone.else@example.com
SMTP_STARTTLS=true
SMTP_SSL=false

# --- alerts: whatsapp ------------------------------------------------------
# none | meta | twilio | webhook        (see README for the trade-offs)
WHATSAPP_DRIVER=none

# meta cloud api -- business-initiated alerts REQUIRE an approved template
# WA_PHONE_NUMBER_ID=
# WA_TOKEN=
# WA_TO=97312345678
# WA_TEMPLATE_NAME=ihost_alert
# WA_TEMPLATE_LANG=en

# twilio
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=whatsapp:+14155238886
# TWILIO_TO=whatsapp:+97312345678

# generic relay (CallMeBot, n8n, your own bridge)
# WA_WEBHOOK_URL=
# WA_WEBHOOK_METHOD=POST
# WA_WEBHOOK_FIELD=text

NOTIFY_COOLDOWN_SEC=900

# --- web -------------------------------------------------------------------
WEB_PORT=8126
# Optional shared secret. Empty means anyone on your LAN can open the page.
WEB_TOKEN=
